{
    "authLoginCustomMessage": null,
    "authActiveAuthMethods": [ "local", "openid" ],
    "authOpenIDIssuerURL": "https://${APP_AUTH_HOST}",
    "authOpenIDAuthorizationURL": "https://${APP_AUTH_HOST}/api/oidc/authorization",
    "authOpenIDTokenURL": "https://${APP_AUTH_HOST}/api/oidc/token",
    "authOpenIDUserInfoURL": "https://${APP_AUTH_HOST}/api/oidc/userinfo",
    "authOpenIDJwksURL": "https://${APP_AUTH_HOST}/jwks.json",
    "authOpenIDLogoutURL": "https://${APP_AUTH_HOST}/logout?rd=https%3A%2F%2Faudiobookshelf.${APP_HOST}",
    "authOpenIDClientID": "${ABS_OAUTH_CLIENT_ID}",
    "authOpenIDClientSecret": "${ABS_OAUTH_CLIENT_SECRET}",
    "authOpenIDTokenSigningAlgorithm": "RS256",
    "authOpenIDMobileRedirectURIs": [ "audiobookshelf://oauth" ],
    "authOpenIDSubfolderForRedirectURLs": "",
    "authOpenIDButtonText": "Login with Authelia",
    "authOpenIDMatchExistingBy": "username",
    "authOpenIDAutoLaunch": true,
    "authOpenIDAutoRegister": true,
    "authOpenIDGroupClaim": "groups",
    "authOpenIDAdvancedPermsClaim": ""
}