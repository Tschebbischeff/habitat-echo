{
    "name": "Podcasts",
    "provider": "itunes",
    "folders": [
        {
            "fullPath": "/podcasts"
        }
    ],
    "icon": "microphone-1",
    "mediaType": "podcast",
    "settings": {
        "coverAspectRatio": 1,
        "disableWatcher": false,
        "autoScanCronExpression": null,
        "markAsFinishedPercentComplete": null,
        "markAsFinishedTimeRemaining": 10,
        "podcastSearchRegion": "${ABS_LIBRARY_DEFAULT_PODCAST_SEARCH_REGION}"
    }
}